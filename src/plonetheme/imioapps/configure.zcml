<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
    xmlns:i18n="http://namespaces.zope.org/i18n"
    xmlns:plone="http://namespaces.plone.org/plone"
    i18n_domain="plonetheme.imioapps">

  <i18n:registerTranslations directory="locales" />

  <!-- Publish the theme directory as ++theme++imioapps -->
  <plone:static
      name="imioapps"
      directory="theme"
      type="theme"
      />

  <genericsetup:registerProfile
      name="default"
      title="iMio applications theme (base)"
      description="Base theme for every iMio application. Install one skin profile too."
      directory="profiles/default"
      provides="Products.GenericSetup.interfaces.EXTENSION"
      />

  <genericsetup:registerProfile
      name="iadelib"
      title="iMio applications theme: iA.Delib skin"
      description="Skin for iA.Delib. Needs the base profile."
      directory="profiles/iadelib"
      provides="Products.GenericSetup.interfaces.EXTENSION"
      />

  <genericsetup:registerProfile
      name="ged"
      title="iMio applications theme: GED skin"
      description="Skin for GED. Needs the base profile."
      directory="profiles/ged"
      provides="Products.GenericSetup.interfaces.EXTENSION"
      />

  <genericsetup:registerProfile
      name="uninstall"
      title="iMio applications theme (uninstall)"
      directory="profiles/uninstall"
      provides="Products.GenericSetup.interfaces.EXTENSION"
      />

</configure>
