<?xml version="1.0"?>
<registry>

  <!-- Skin CSS for GED. It loads after the base theme CSS and only
       redefines the custom properties a skin owns. -->
  <records interface="plone.base.interfaces.resources.IBundleRegistry"
           prefix="plone.bundles/imioapps-ged">
    <value key="enabled">True</value>
    <value key="csscompilation">++theme++imioapps/styles/skin-ged.min.css</value>
    <value key="depends">plone</value>
    <value key="load_async">False</value>
    <value key="load_defer">False</value>
  </records>

</registry>
