<?xml version="1.0"?>
<registry>

  <!-- Skin CSS for iA.Delib. It redefines only the custom properties a skin
       owns, so it must load after the base theme CSS.

       Plone renders the Diazo theme CSS after every bundle of the
       registry. The value "all" moves a bundle to the deferred group,
       which Plone renders after the theme CSS. Any other value puts the
       skin before the base, where the base wins. -->
  <records interface="plone.base.interfaces.resources.IBundleRegistry"
           prefix="plone.bundles/imioapps-iadelib">
    <value key="enabled">True</value>
    <value key="csscompilation">++theme++imioapps/styles/skin-iadelib.min.css</value>
    <value key="depends">all</value>
    <value key="load_async">False</value>
    <value key="load_defer">False</value>
  </records>

</registry>
